## Hank as a service: vision + tracking + music page, restarted if it crashes.
##   sudo systemctl enable --now hank      start now and at every boot
##   journalctl -u hank -f                 follow the logs
## Runs as your user: no sudo needed (pigpio goes through the daemon, the
## camera through the 'video' group, the keyboard through 'input').
[Unit]
Description=Hank robot (vision + personality + music server)
After=network-online.target pigpiod.service raspotify.service
Wants=network-online.target pigpiod.service

[Service]
User=hank
WorkingDirectory=/home/hank/Documents/Hank
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/hank/Documents/Hank/.venv/bin/python main.py --mode bartender --no-display
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
